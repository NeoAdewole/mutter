<%# locals: pagination (Paginatable::Pagination), noun (e.g. "users") %>
<nav class="mt-4 flex flex-wrap items-center justify-between gap-2" aria-label="Pagination" data-pagination>
  <p class="text-sm text-base-content/70">
    <% if pagination.total.zero? %>
      No <%= noun %>.
    <% else %>
      Showing <%= pagination.first_item %>–<%= pagination.last_item %> of <%= pagination.total %> <%= noun %>
    <% end %>
  </p>
  <% if pagination.pages > 1 %>
    <div class="join">
      <% if pagination.previous_page %>
        <%= link_to "Previous", page_url(pagination.previous_page), class: "join-item btn btn-sm", rel: "prev" %>
      <% end %>
      <span class="join-item btn btn-sm btn-disabled">Page <%= pagination.page %> of <%= pagination.pages %></span>
      <% if pagination.next_page %>
        <%= link_to "Next", page_url(pagination.next_page), class: "join-item btn btn-sm", rel: "next" %>
      <% end %>
    </div>
  <% end %>
</nav>
