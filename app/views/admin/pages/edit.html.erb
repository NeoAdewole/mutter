<div class="my-6">
  <%= link_to "← All pages", admin_pages_path, class: "link link-hover text-sm" %>
  <h1 class="mt-2 text-3xl font-bold"><%= @page.site_page? ? "Edit site page" : "Edit page" %></h1>
  <p class="mt-1 text-sm text-base-content/70">
    <%= @page.site_page? ? "Site page" : @page.section_info.title %> ·
    <%# Use the saved record: after a failed save @page holds unsaved edits. %>
    <% saved = Page.find(@page.id) %>
    <%= link_to "View#{' (draft preview)' unless saved.published?}", saved.public_path, class: "link" %>
  </p>
  <%= render "form", page: @page, parent_choices: @page.site_page? ? [] : Page.parent_choices(@page) %>
  <%= render "admin/blocks/panel", page: saved %>
</div>
