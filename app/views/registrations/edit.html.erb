<h1>Update profile</h1>

<%= form_with model: @user, url: registration_path do |form| %>
  <%= render "shared/form_errors", form: form%>

  <div class="col-auto mb-3">
    <%= form.label :email, class: "form-label" %>
    <%= form.email_field :email, class: "form-control", value: @user.email %>
  </div>

  <div class="col-auto mb-3">
    <%= form.label :firstname, class: "form-label" %>
    <%= form.text_field :firstname, class: "form-control" %>
  </div>

  <div class="col-auto mb-3">
    <%= form.label :lastname, class: "form-label" %>
    <%= form.text_field :lastname, class: "form-control" %>
  </div>

  <div class="col-auto mb-3">
    <%= form.label :username, class: "form-label" %>
    <%= form.text_field :username, class: "form-control" %>
  </div>

  <div class="col-auto mb-4 flex items-start gap-3">
    <%= form.check_box :show_stream_on_homepage, class: "mt-1 size-4 accent-purple-500" %>
    <div>
      <%= form.label :show_stream_on_homepage, "Show my stream on the home page when I'm live", class: "font-medium" %>
      <p class="text-sm text-gray-400">
        If you've connected Twitch, your stream can be featured in the home page carousel while you're live.
        Turn this off to keep it out of the carousel (it doesn't affect your Streaming page).
      </p>
    </div>
  </div>

  <div class="input-group mb3 justify-content-between">
    <div class="col-auto">
      <%= link_to "Cancel", :root, class: "btn btn-danger mb-3" %>
    </div>
    <div class="col-auto">
      <%= form.submit "Update", class: "btn btn-primary mb-3" %>
    </div>
  </div>
<% end %>

<h2>Connected Accounts</h2>
<% if @identities.any? %>
  <ul>
    <% @identities.each do |identity| %>
      <li>
        <%= identity.provider.capitalize %>
        connected <%= identity.created_at.strftime("%b %-d, %Y") %>
        <%= link_to "Disconnect", identity_path(identity), method: :delete, data: { confirm: "Are you sure you want to disconnect this account?" } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No connected accounts.</p>
<% end %>

<% connected_provider_keys = @identities.map(&:provider) %>
<% connectable_providers = identity_providers.reject { |provider| connected_provider_keys.include?(provider[:key]) } %>
<% if connectable_providers.any? %>
  <h2>Connect another provider</h2>
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 my-4">
    <% connectable_providers.each do |provider| %>
      <div class="col-auto">
        <%= button_to "Connect #{provider[:label]}", "/auth/#{provider[:key]}?connect=true",
                       method: :post, data: { turbo: 'false' }, class: 'btn btn-secondary' %>
      </div>
    <% end %>
  </div>
<% end %>

<%= button_to "Delete Account", registration_path, method: :delete, data: { confirm: "Are you sure you want to delete your account? This action cannot be undone." } %>