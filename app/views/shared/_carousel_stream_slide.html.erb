<%# A live Twitch stream as a carousel slide. The player has no src here: carousel_controller.js
    sets it only while this slide is showing, so several live streams don't all autoplay at once.
    Twitch requires the embedding site as `parent`. Locals: stream (Twitch::Stream), position, total. %>
<% player_src = "https://player.twitch.tv/?#{{ channel: stream.login, parent: request.host, muted: true, autoplay: true }.to_query}" %>
<div
  class="w-full shrink-0 snap-center"
  role="group"
  aria-roledescription="slide"
  aria-label="<%= position %> of <%= total %>: <%= stream.name %> live on Twitch"
  data-carousel-target="slide">
  <%# Banner-shaped (3:1) on wider screens; 16:9 on small ones so the player isn't a sliver. %>
  <div class="flex aspect-video w-full overflow-hidden bg-black tablet:aspect-[3/1]">
    <%# Below the tablet breakpoint there's no room for text, so the player takes everything.
        Left padding clears the carousel's overlaid "previous" button. %>
    <div class="hidden w-1/3 min-w-0 flex-col justify-center gap-2 bg-linear-to-r from-purple-950 to-black py-6 pl-16 pr-6 text-white tablet:flex">
      <span class="inline-flex w-fit items-center gap-1.5 rounded bg-red-600 px-2 py-0.5 text-xs font-bold uppercase tracking-wide">
        <span class="size-1.5 rounded-full bg-white" aria-hidden="true"></span>
        Live
      </span>
      <h2 class="truncate text-2xl font-semibold"><%= stream.name %></h2>
      <p class="line-clamp-2 text-sm text-gray-200"><%= stream.title %></p>
      <p class="truncate text-xs text-gray-400"><%= stream.game %> &middot; <%= number_with_delimiter(stream.viewers) %> watching</p>
      <%= link_to "Watch on Twitch", "https://www.twitch.tv/#{stream.login}", target: "_blank", rel: "noopener noreferrer",
                  class: "mt-1 w-fit rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-purple-500" %>
    </div>
    <iframe
      class="h-full min-w-0 flex-1"
      title="<%= stream.name %> live on Twitch"
      allow="autoplay; fullscreen"
      allowfullscreen
      data-carousel-target="frame"
      data-src="<%= player_src %>"></iframe>
  </div>
</div>
