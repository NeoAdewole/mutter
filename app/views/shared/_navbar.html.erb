<%
  nav_links = [
    ["Home", root_path],
    ["About", about_path],
    ["Twitter Accounts", twitter_accounts_path],
    ["Tweets", tweets_path],
    ["Streaming", streaming_path]
  ]
%>
<div class="container mx-auto px-4">
  <%# Below the laptop breakpoint the links move into a slide-out drawer (CSS only, no JS). %>
  <div class="drawer">
    <input id="nav-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content">
      <nav class="navbar bg-base-300 rounded-lg mb-2" id="main-nav">
        <div class="navbar-start gap-1">
          <label for="nav-drawer" aria-label="Open menu" class="btn btn-square btn-ghost laptop:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block h-6 w-6 stroke-current">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
          <%= link_to "Mutter", root_path, class: "btn btn-ghost text-xl" %>
        </div>

        <div class="navbar-center hidden laptop:flex">
          <ul class="menu menu-horizontal gap-1">
            <% nav_links.each do |label, path| %>
              <li><%= link_to label, path, class: ("menu-active" if current_page?(path)) %></li>
            <% end %>
          </ul>
        </div>

        <div class="navbar-end">
          <% if user_signed_in? %>
            <div class="dropdown dropdown-end">
              <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
                <div class="w-10 rounded-full">
                  <img
                    alt="User menu"
                    src="https://img.daisyui.com/images/stock/photo-1534528741775-53994a69daeb.webp" />
                </div>
              </div>
              <ul
                tabindex="0"
                class="dropdown-content menu menu-sm bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow">
                <li><%= link_to (Current.user.username || "Profile"), edit_registration_path %></li>
                <li><%= link_to (Current.user.password_set? ? "Change password" : "Add password"), edit_password_path %></li>
                <li><%= button_to "Log out", session_path, method: :delete %></li>
              </ul>
            </div>
          <% else %>
            <%# On small screens these live in the drawer instead. %>
            <ul class="menu menu-horizontal hidden tablet:flex">
              <li><%= link_to "Sign Up", new_registration_path %></li>
              <li><%= link_to "Log In", new_session_path %></li>
            </ul>
          <% end %>
        </div>
      </nav>
    </div>

    <div class="drawer-side z-50 laptop:hidden">
      <label for="nav-drawer" aria-label="Close menu" class="drawer-overlay"></label>
      <ul class="menu bg-base-200 text-base-content min-h-full w-72 p-4 gap-1">
        <li class="mb-2">
          <%= link_to "Mutter", root_path, class: "text-xl font-bold" %>
        </li>
        <% nav_links.each do |label, path| %>
          <li><%= link_to label, path, class: ("menu-active" if current_page?(path)) %></li>
        <% end %>
        <% unless user_signed_in? %>
          <li class="menu-title mt-4">Account</li>
          <li><%= link_to "Sign Up", new_registration_path %></li>
          <li><%= link_to "Log In", new_session_path %></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
