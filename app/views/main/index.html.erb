<div class="relative"><%= render "shared/carousel", streams: @live_streams %></div>

<!-- Main content -->

<div class="main-content container mx-auto my-4 bg-base-500 sm:bg-copper-900 md:bg-base-900">
  <section id="offers" class="offers grid lg:grid-cols-4 md:grid-cols-2 sm:grid-cols-1 gap-4">
    <div class="category card bg-base-300 shadow-sm">
      <figure>
        <img
          src="https://picsum.photos/id/435/928/548"
          alt="Camera" />
      </figure>
      <div class="card-body">
        <h2 class="card-title">Streaming</h2>
        <p>A card component has a figure, a body part, and inside body there are title and actions parts.
        Whether IRL, music or gaming, get the tools you need to keep chat engaged and manage your stream.
        </p>
        <div class="card-actions justify-end">
          <%= link_to "Explore Streaming", section_path("streaming"), class: "btn btn-primary" %>
        </div>
      </div>      
    </div>
    <div class="category card bg-base-300 shadow-sm">
      <figure>
        <img
          src="https://picsum.photos/id/403/928/548"
          alt="Typewriter" />
      </figure>
      <div class="card-body">
        <h2 class="card-title">Content</h2>
        <p>A card component has a figure, a body part, and inside body there are title and actions parts.
          Whatever level you are in your content creation journey, get resourcer that to push you to the next stage. 
        </p>
        <div class="card-actions justify-end">
          <%= link_to "Explore Content", section_path("content"), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
    <div class="category card bg-base-300 shadow-sm">
      <figure>
        <img
          src="https://picsum.photos/id/96/928/548"
          alt="Game Controller" />
      </figure>
      <div class="card-body">
        <h2 class="card-title">Gaming</h2>
        <p>A card component has a figure, a body part, and inside body there are title and actions parts</p>
        <div class="card-actions justify-end">
          <%= link_to "Explore Gaming", section_path("gaming"), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
    <div class="category card bg-base-300 shadow-sm">
      <figure>
        <img
          src="https://picsum.photos/id/672/928/548"
          alt="Floor shot showing feet and shoes of passengers in a bus" />
      </figure>
      <div class="card-body">
        <h2 class="card-title">Community</h2>
        <p>A card component has a figure, a body part, and inside body there are title and actions parts</p>
        <div class="card-actions justify-end">
          <%= link_to "Explore Community", section_path("community"), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </section>
  <section id="info">
    <p>We are building a digital community for creatives to collaborate and create tools and solutions that help you do what you better.
      </br>
      Join us today and be part of the journey to create a space that:
    </p>
    <ul>
      <li>Empowers creators</li>
      <li>Fosters collaboration</li>
      <li>Encourages innovation</li>
      <li>Builds lasting connections</li>
    </ul> 
  </section>
</div>